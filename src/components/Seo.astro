---
interface Props {
  title: string;
  description: string;
  slug: string;
  section: string;
  ogImage?: string;
}

const { title, description, slug, section, ogImage } = Astro.props;

const site = Astro.site!;
const siteHref = site.href; // 'https://docs.stackbilder.com/'
const siteOrigin = site.origin; // 'https://docs.stackbilder.com'

// Trailing slash canonical — matches Astro's default build.format: 'directory'
const canonicalUrl = slug ? new URL(`${slug}/`, site).href : siteHref;

// Meta description: cap at 159 chars + ellipsis if needed
const metaDescription =
  description.length > 160 ? description.slice(0, 159) + '…' : description;

const pageTitle = `${title} — Docs by Stackbilt`;

// Markdown alternate URL (GEO agent discovery)
const markdownUrl = slug ? new URL(`${slug}.md`, site).href : null;

// Graph-based JSON-LD: interconnected @id references so AI agents can walk relationships
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'Docs by Stackbilt',
      url: siteHref,
      publisher: { '@id': 'https://stackbilder.com/#organization' },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteOrigin}/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://stackbilder.com/#organization',
      name: 'Stackbilt',
      url: 'https://stackbilder.com',
      sameAs: [
        'https://github.com/Stackbilt-dev',
        'https://www.npmjs.com/org/stackbilt',
      ],
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://stackbilder.com/#logo',
        url: `${siteOrigin}/favicon.svg`,
        contentUrl: `${siteOrigin}/favicon.svg`,
        width: 48,
        height: 48,
        caption: 'Stackbilt logo',
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://stackbilder.com/#author',
      name: 'Kurt Overmier',
      url: 'https://stackbilder.com',
      image: {
        '@type': 'ImageObject',
        '@id': 'https://stackbilder.com/#author-photo',
        url: `${siteOrigin}/author.jpg`,
        width: 400,
        height: 400,
        caption: 'Kurt Overmier',
      },
      sameAs: [
        'https://www.buymeacoffee.com/kurto',
      ],
    },
    {
      '@type': 'TechArticle',
      '@id': `${canonicalUrl}#article`,
      isPartOf: { '@id': `${siteOrigin}/#website` },
      headline: title,
      description: metaDescription,
      url: canonicalUrl,
      author: { '@id': 'https://stackbilder.com/#author' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      publisher: { '@id': 'https://stackbilder.com/#organization' },
      inLanguage: 'en-US',
      ...(ogImage
        ? {
            image: {
              '@type': 'ImageObject',
              url: ogImage,
              width: 1200,
              height: 630,
            },
          }
        : {}),
      ...(markdownUrl
        ? {
            encoding: {
              '@type': 'MediaObject',
              encodingFormat: 'text/markdown',
              contentUrl: markdownUrl,
            },
          }
        : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          item: { '@type': 'WebPage', '@id': siteHref, name: 'Docs', url: siteHref },
        },
        {
          '@type': 'ListItem',
          position: 2,
          item: {
            '@type': 'WebPage',
            '@id': canonicalUrl,
            name: title,
            url: canonicalUrl,
          },
        },
      ],
    },
  ],
};
---

<!-- Primary SEO -->
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />
{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

<!-- Open Graph -->
<meta property="og:type" content="article" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={`${title} documentation — Stackbilt`} />}
<meta property="og:site_name" content="Docs by Stackbilt" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={`${title} documentation — Stackbilt`} />}

<!-- JSON-LD structured data graph -->
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
